{
  "name": "jeffa-dev-rules",
  "version": "1.0.0",
  "description": "Owner-first engineering rules for every session, plus guards that keep secrets out of git and out of the transcript.",
  "author": {
    "name": "J3ff4",
    "url": "https://github.com/J3ff4"
  },
  "repository": "https://github.com/J3ff4/jeffa-dev-rules",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/CLAUDE.md\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "license": "MIT"
}
